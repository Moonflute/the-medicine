[{"id":"theory-y2n8n0wybjy2etg3n3lqn0wyvty2zuo3wjzzfgnjlta0lxjly29nbml0aw9ufgrpcmvjdf9yzwnhbgw","sourcePath":"source_notes/99 Q-bank/Theory/03 호흡기/theory-8439cab633b06cca6152b190.md","source":"Internal-Theory","sourceSplit":"theory","specialty":"03 호흡기","specialtySlug":"MDMg7Zi47Z2h6riw","relatedDiseaseTerms":[],"relatedDiseaseSlugs":[],"relatedCcSlugs":["7L2n66y877yP7L2U66eJ7Z6Y"],"relatedDrugSlugs":[],"relatedDrugs":[],"questionType":"recognition","difficulty":"standard","question":"콧물·코막힘에서 단순 비염으로 넘기지 말고 추가 평가가 필요한 양상은?","options":{"A":"계절에 따라 양측 코 가려움·재채기가 반복된다","B":"편측 증상이 지속되며 혈성 분비물·반복 코피 또는 종괴가 동반된다","C":"짧은 감기 경과에서 양측 맑은 콧물이 호전된다","D":"간헐적인 가벼운 코막힘이 완전히 해소된다"},"answer":"B","explanation":"지속적인 편측 코막힘·분비물, 출혈·종괴는 구조적 병변이나 종양 등 추가 평가가 필요한 단서다. 이비인후과 진찰·비내시경을 포함해 평가하고 CT/MRI는 의심 원인에 따라 선택한다. 모든 콧물이나 단순 알레르기 비염에 영상검사를 일률적으로 시행하는 것은 아니다.","translationStatus":"not-applicable","explanationStatus":"manual-reviewed","reviewStatus":"manual-reviewed","questionBank":"theory","targetType":"cc","targetSlug":"7L2n66y877yP7L2U66eJ7Z6Y","targetTitle":""},{"id":"theory-y2n8n0wybjy2etg3n3lqn0wyvty2zuo3wjzzfgnjltaxlxjly29nbml0aw9ufgrpcmvjdf9yzwnhbgw","sourcePath":"source_notes/99 Q-bank/Theory/03 호흡기/theory-a18d2c3e83711588b9081d95.md","source":"Internal-Theory","sourceSplit":"theory","specialty":"03 호흡기","specialtySlug":"MDMg7Zi47Z2h6riw","relatedDiseaseTerms":[],"relatedDiseaseSlugs":[],"relatedCcSlugs":["7L2n66y877yP7L2U66eJ7Z6Y"],"relatedDrugSlugs":[],"relatedDrugs":[],"questionType":"recognition","difficulty":"standard","question":"다음 중 알레르기성 비염을 시사하는 특징은?","options":{"A":"10일 이상 지속되는 고름성 비강 분비물","B":"꽃가루에 의해 유발되는 코 가려움·재채기","C":"편측 출혈성 비강 분비물","D":"발열과 안면통"},"answer":"B","explanation":"알레르기성 비염은 가려움·재채기·눈 가려움 등 알레르기 증상이 동반되고, 특정 알레르겐에 의해 유발된다.","translationStatus":"not-applicable","explanationStatus":"machine-generated","reviewStatus":"machine-generated","questionBank":"theory","targetType":"cc","targetSlug":"7L2n66y877yP7L2U66eJ7Z6Y","targetTitle":""},{"id":"theory-y2n8