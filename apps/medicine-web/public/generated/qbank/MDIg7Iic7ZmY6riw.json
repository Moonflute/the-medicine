[{"id":"theory-y2n8n0l1azdjdwd8y2mtmdetcmvjb2duaxrpb258zglyzwn0x3jly2fsba","sourcePath":"source_notes/99 Q-bank/Theory/02 순환기/theory-48a7e19c55463baa79702b42.md","source":"Internal-Theory","sourceSplit":"theory","specialty":"02 순환기","specialtySlug":"MDIg7Iic7ZmY6riw","relatedDiseaseTerms":[],"relatedDiseaseSlugs":[],"relatedCcSlugs":["7Iuk7Iug"],"relatedDrugSlugs":[],"relatedDrugs":[],"questionType":"recognition","difficulty":"standard","question":"실신에서 심장성 원인을 특히 의심하게 하는 병력은?","options":{"A":"오래 서 있다가 오심·식은땀을 느낀 뒤 발생","B":"채혈 중 통증과 공포에 이어 발생","C":"운동 중 전조 없이 발생","D":"기립 직후 어지러움과 함께 혈압이 떨어짐"},"answer":"C","explanation":"운동 중 또는 누운 상태에서 발생한 실신, 갑작스러운 두근거림과 동반된 실신은 심장성 원인을 평가할 위험 단서다. 이 병력만으로 특정 부정맥을 확진하는 것은 아니다.","translationStatus":"not-applicable","explanationStatus":"manual-reviewed","reviewStatus":"manual-reviewed","questionBank":"theory","targetType":"cc","targetSlug":"7Iuk7Iug","targetTitle":""},{"id":"theory-y2n8n0l1azdjdwd8y2mtmdqtcmvjb2duaxrpb258zglyzwn0x3jly2fsba","sourcePath":"source_notes/99 Q-bank/Theory/02 순환기/theory-e6fc8a22d5c5a73165325949.md","source":"Internal-Theory","sourceSplit":"theory","specialty":"02 순환기","specialtySlug":"MDIg7Iic7ZmY6riw","relatedDiseaseTerms":[],"relatedDiseaseSlugs":[],"relatedCcSlugs":["7Iuk7Iug"],"relatedDrugSlugs":[],"relatedDrugs":[],"questionType":"recognition","difficulty":"standard","question":"실신 초기 평가에서 12유도 ECG를 시행하는 목적과 해석으로 옳은 것은?","options":{"A":"부정맥·전도장애·허혈 등 심장성 단서를 찾으며 정상 단일 기록만으로 간헐적 부정맥을 배제하지 않는다","B":"정상 결과이면 심장성 실신을 완전히 배제한다","C":"ECG만으로 기립성 저혈압을 확진한다","D":"정상 ECG이면 자세·약물·가족력 문진은 필요 없다"},"answer":"A","explanation":"12유도 ECG는 실신 초기 평가의 기본 검사로 부정맥·전도장애·허혈·유전성 부정맥 소인 등의 단서를 찾는다. 간헐적 부정맥은 증상 사이 ECG에 잡히지 않을 수 있으므로 병력·진찰·기립 혈압 및 필요 시 지속·장기 모니터링과 함께 해석한다.","translationStatus":"not-applicable","explanationStatus":"manual-reviewed","reviewStatus":"manual-reviewed","questionBank":"theory","targetType":"cc","targetSlug":"7Iuk7Iug","targetTitle":""},{"id":"theory-y2n8n0l1azdjdwd8y2mtmdutcmvjb2duaxrpb258zglyzwn0x3jly2fsba","sourcePath":"source_notes/99 Q-bank/Theory/02 순환기/theory-fcae43f590279669d6cf206a.md","source":"Internal-Theory","sourceSplit":"theory","specialty":"02 순환기","specialtySlug":"MDIg7Iic7ZmY6riw","relatedDiseaseTerms":[],"relatedDiseaseSlugs":[],"relatedCcSlugs":["7Iuk7Iug"],"relatedDrugSlugs":[],"relatedDrugs":[],"questionType":"recognition","difficulty":"standard","question":"실신에서 일률적인 뇌 CT/MRI가 권고되지 않는 상황은?","options":{"A":"국소 신경학적 이상과 두부외상 등 별도 적응증이 없는 단순 실신","B":"실신과 함께 새 편측 마비가 발생한 경우","C":"넘어지며 머리를 다쳤고 두부손상이 의심되는 경우","D":"의식장애가 지속되어 단순 실신으로 설명되지 않는 경우"},"answer":"A","explanation":"단순 실신의 원인을 찾기 위해 뇌영상을 일률적으로 시행하지 않는다. 국소 신경학적 이상, 두부손상 또는 다른 신경계 질환이 의심되는 단서는 별도 평가가 필요하다.","translationStatus":"not-applicable","explanationStatus":"manual-reviewed","reviewStatus":"manual-reviewed","questionBank":"theory","targetType":"cc","targetSlug":"7Iuk7Iug","targetTitle":""},{"id":"theory-y2n8n0oymddjt0i3s2vbn0tlstdaauk3s2fkfgnjltaxlxjly29nbml0aw9ufgrpcmvjdf9yzwnhbgw","sourcePath":"source_notes/99 Q-bank/Theory/02 순환기/theory-de8d6edff9da5c5e2d3e0483.md","source":"Internal-Theory","sourceSplit":"theory","specialty":"02 순환기","specialtySlug":"MDIg7Iic7ZmY6riw","relatedDiseaseTerms":[],"relatedDiseaseSlugs":[],"relatedCcSlugs":["7J207IOB7KeA7KeI7ZiI7Kad"],"relatedDrugSlugs":[],"relatedDrugs":[],"questionType":"recognition","difficulty":"standard","question":"이상지질혈증의 치료 강도는 무엇을 종합하여 결정합니까?","options":{"A":"전체 심혈관 위험, LDL 상승 정도, 이차성 원인","B":"LDL 수치만","C":"총 콜레스테롤 수치만","D":"트리글리세리드 수치만"},"answer":"A","explanation":"치료 강도는 전체 심혈관 위험, LDL 상승 정도, 이차성 원인을 모두 고려해 결정합니다.","translationStatus":"not-applicable","explanationStatus":"machine-generated","reviewStatus":"machine-generated","questionBank":"theory","targetType":"cc","targetSlug":"7J207IOB7KeA7KeI7ZiI7Kad","targetTitle":""},{"id":"theory-y2n8njvhutzyztg2ckd3njzhohxjyy0wms1yzwnvz25pdglvbnxkaxjly3rfcmvjywxs","sourcePath":"source_notes/99 Q-bank/Theory/02 순환기/theory-a315a4dd4c72e207af8ac4f8.md","source":"Internal-Theory","sourceSplit":"theory","specialty":"02 순환기","specialtySlug":"MDIg7Iic7ZmY6riw","relatedDiseaseTerms":[],"relatedDiseaseSlugs":[],"relatedCcSlugs":["65GQ6re86rGw66a8"],"relatedDrugSlugs":[],"relatedDrugs":[],"questionType":"recognition","difficulty":"standard","question":"두근거림 병력에서 심장성 위험을 높여 신속한 평가를 요구하는 조합은?","options":{"A":"운동 연관 실신·전실신, 구조적 심질환 또는 젊은 나이의 돌연사 가족력","B":"증상이 짧았다는 이유만으로 위험 원인이 없다고 판단한다","C":"증상 뒤 진찰이 정상이면 부정맥 가능성을 배제한다","D":"불안을 함께 느끼면 심장 검사를 생략한다"},"answer":"A","explanation":"두근거림은 시작·종료·지속시간·맥박 변화와 함께 실신·전실신, 운동 연관성, 구조적 심질환과 돌연사 가족력을 확인한다. 이런 단서는 위험 부정맥 가능성을 높인다. 증상이 사라진 뒤 정상 진찰이나 정상 단일 ECG만으로 간헐적 부정맥을 배제하지 않으며 필요하면 증상 빈도에 맞춰 리듬 기록을 계획한다.","translationStatus":"not-applicable","explanationStatus":"manual-reviewed","reviewStatus":"manual-reviewed","questionBank":"theory","targetType":"cc","targetSlug":"65GQ6re86rGw66a8","targetTitle":""},{"id":"theory-y2n8njvhutzyztg2ckd3njzhohxjyy0wnc1yzwnvz25pdglvbnxkaxjly3rfcmvjywxs","sourcePath":"source_notes/99 Q-bank/Theory/02 순환기/theory-9786e6fcc428cc63133de45c.md","source":"Internal-Theory","sourceSplit":"theory","specialty":"02 순환기","specialtySlug":"MDIg7Iic7ZmY6riw","relatedDiseaseTerms":[],"relatedDiseaseSlugs":[],"relatedCcSlugs":["65GQ6re86rGw66a8"],"relatedDrugSlugs":[],"relatedDrugs":[],"questionType":"recognition","difficulty":"standard","question":"맥박이 있는 규칙적 빈맥으로 혈역학적 불안정이 발생하고 동기화가 가능한 경우, 우선 고려하는 전기 치료는?","options":{"A":"동기화 심율동전환","B":"심실세동과 같은 비동기 제세동","C":"경피적 심박조율","D":"심실조기수축 억제를 위한 예방적 충격"},"answer":"A","explanation":"맥박이 있는 불안정 빈맥에는 보통 동기화 심율동전환을 시행한다. 무맥성 심실빈맥·심실세동은 비동기 제세동 대상이며, 다형성 심실빈맥도 신뢰할 수 있는 동기화가 어려워 별도로 구분한다.","translationStatus":"not-applicable","explanationStatus":"manual-reviewed","reviewStatus":"manual-reviewed","questionBank":"theory","targetType":"cc","targetSlug":"65GQ6re86rGw66a8","targetTitle":""},{"id":"theory-y2n8nnjdqtdjcta3wwexn0thzhxpbml0awfslwvjzy10aw1pbmd8y2xpbmljywxfyxbwbgljyxrpb24","sourcePath":"source_notes/99 Q-bank/Theory/02 순환기/theory-58d2006788c5625ba63d1ed8.md","source":"Internal-Theory","sourceSplit":"theory","specialty":"02 순환기","specialtySlug":"MDIg7Iic7ZmY6riw","relatedDiseaseTerms":[],"relatedDiseaseSlugs":[],"relatedCcSlugs":["6rCA7Iq07Ya17Kad"],"relatedDrugSlugs":[],"relatedDrugs":[],"questionType":"next_action","difficulty":"standard","question":"급성 관상동맥증후군이 의심되는 흉통에서 초기 12유도 심전도가 진단적이지 않을 때 옳은 해석은?","options":{"A":"심전도 한 번이 정상이면 ACS를 배제한다","B":"증상과 위험도를 함께 평가하며 필요하면 심전도를 반복한다","C":"심전도 변화가 없으면 심근손상표지자 검사는 의미가 없다","D":"흉통이 사라지면 초기 심전도의 결과와 무관하게 심장성 원인은 배제된다"},"answer":"B","explanation":"초기 심전도는 신속히 확인하지만 정상 또는 비진단적 결과만으로 ACS를 배제하지 않는다. 지속·재발 증상과 임상 위험도에 따라 연속 심전도와 심근손상표지자 등을 평가한다.","translationStatus":"not-applicable","explanationStatus":"manual-reviewed","reviewStatus":"manual-reviewed","questionBank":"theory","targetType":"cc","targetSlug":"6rCA7Iq07Ya17Kad","targetTitle":""}]
